# ---- Required --------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=111111111

# ---- Optional --------------------------------------------------------------
# Group/supergroup/channel IDs (negative numbers) where the bot may work.
# In groups the sender must ALSO be in ALLOWED_USER_IDS.
ALLOWED_CHAT_IDS=

# Self-hosted Bot API server: raises the upload limit from 50 MB to 2 GB and
# skips compression. Leave empty to use Telegram's cloud API.
TELEGRAM_API_URL=
# Only needed for the optional telegram-bot-api service in docker-compose.yml
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Netscape-format cookies.txt files (paths INSIDE the container, mounted
# read-only from ./cookies). Use secondary/throwaway accounts.
INSTAGRAM_COOKIES_FILE=
REDDIT_COOKIES_FILE=
YOUTUBE_COOKIES_FILE=
X_COOKIES_FILE=

MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=300
# true = delete the "Downloading…" status message after success (errors are kept)
DELETE_STATUS_MESSAGES=false

# Reddit asks API clients for a descriptive User-Agent.
REDDIT_USER_AGENT=linux:private-tg-video-bot:v1.0 (personal single-user bot)
# Seconds in-flight jobs get to finish on shutdown before being cancelled
SHUTDOWN_GRACE_SECONDS=30
LOG_LEVEL=INFO

# docker-compose only: size of the RAM-backed /tmp
TMPFS_SIZE=1g
